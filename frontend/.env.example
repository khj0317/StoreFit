# Vercel → Project → Settings → Environment Variables 에 넣는다. (로컬은 frontend/.env.local)
# 실제 키는 이 파일에 넣지 마세요.

# 카카오 지도 JavaScript 키 (지점 지도·관리자 주소→좌표 변환). 비우면 지도 없이 목록만 보여준다.
# 카카오 개발자 콘솔 → 플랫폼 → Web에 http://localhost:5173 과 Vercel 주소를 등록해야 한다.
VITE_KAKAO_JS_KEY=

# 결제 클라이언트 키. 비우면 결제 서비스가 공개한 테스트 키(실제 결제 안 됨)를 쓴다.
VITE_TOSS_CLIENT_KEY=

# 보통은 비워 둔다: vercel.json이 /api 요청을 Render 백엔드로 넘겨준다.
# 다른 주소로 직접 부르고 싶을 때만 예) https://storefit-api.onrender.com/api
VITE_API_BASE_URL=
