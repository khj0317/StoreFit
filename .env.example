# Copy this file to .env and fill in real values. Never commit the real .env file.

# MySQL
DB_NAME=luggage_storage
DB_USERNAME=luggage_app
DB_PASSWORD=change-me
DB_ROOT_PASSWORD=change-me-too

# Backend
# Generate a real random secret, e.g.: openssl rand -base64 48
JWT_SECRET=change-me-to-a-long-random-string
# Your real Toss Payments secret key -- https://developers.tosspayments.com
TOSS_SECRET_KEY=change-me
