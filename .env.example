# Render(백엔드) 환경 변수 예시. 실제 값은 Render 대시보드 → Environment 에 넣고, 이 파일에는 절대 넣지 마세요.
# 자세한 순서는 DEPLOYMENT.md 참고. (프론트엔드 변수는 frontend/.env.example)

SPRING_PROFILES_ACTIVE=prod

# --- Supabase Postgres (Connect → Session pooler, 포트 5432) ---
DB_URL=jdbc:postgresql://aws-0-ap-northeast-2.pooler.supabase.com:5432/postgres?sslmode=require
DB_USERNAME=postgres.<project-ref>
DB_PASSWORD=<supabase-db-password>
DB_POOL_SIZE=5

# --- 보안 ---
# 32자 이상 랜덤 문자열 (예: openssl rand -base64 48)
JWT_SECRET=<random-64-chars>
# Vercel 주소 (여러 개면 쉼표, * 패턴 가능: https://storefit-*-내계정.vercel.app)
CORS_ALLOWED_ORIGINS=https://<your-app>.vercel.app

# --- 결제 시크릿 키 (결제 서비스 개발자센터 → API 키) ---
TOSS_SECRET_KEY=test_sk_xxxxxxxx

# --- 사진 저장소: Supabase Storage (S3 호환) ---
STORAGE_TYPE=s3
S3_ENDPOINT=https://<project-ref>.storage.supabase.co/storage/v1/s3
S3_REGION=ap-northeast-2
S3_BUCKET=storefit
S3_ACCESS_KEY=<storage-s3-access-key-id>
S3_SECRET_KEY=<storage-s3-secret-access-key>
S3_PUBLIC_URL=https://<project-ref>.supabase.co/storage/v1/object/public/storefit
S3_PATH_STYLE=true

# --- 문자·카카오 알림톡: 솔라피 (https://solapi.com) ---
NOTIFICATION_PROVIDER=solapi
SOLAPI_API_KEY=<solapi-api-key>
SOLAPI_API_SECRET=<solapi-api-secret>
# 솔라피에 등록·인증한 발신번호 (숫자만)
SOLAPI_SENDER=01012345678
# 카카오 알림톡 (선택). 채널 ID와 승인된 템플릿 ID를 넣은 알림만 알림톡으로 가고, 나머지는 문자로 간다
SOLAPI_KAKAO_PF_ID=
KAKAO_TEMPLATE_PAYMENT_DONE=
KAKAO_TEMPLATE_NEW_RESERVATION=
KAKAO_TEMPLATE_CHECKED_IN=
KAKAO_TEMPLATE_CHECKED_OUT=
KAKAO_TEMPLATE_PICKUP_REMINDER=
KAKAO_TEMPLATE_OVERDUE=
KAKAO_TEMPLATE_REFUNDED=
KAKAO_TEMPLATE_PAYMENT_EXPIRED=
KAKAO_TEMPLATE_NO_SHOW=
KAKAO_TEMPLATE_BRANCH_APPROVED=
KAKAO_TEMPLATE_BRANCH_REJECTED=

# --- 본사 관리자 계정 (서버가 처음 켜질 때 없으면 만든다) ---
ADMIN_USERNAME=<admin-id>
ADMIN_PASSWORD=<strong-password>

# --- 로그인 화면 "둘러보기" 체험 계정 (체험 이용자·사장님, 매일 초기화). 끄려면 false ---
DEMO_ENABLED=true
# --- 인증 문자 남용 방지: IP별 시간당 한도, 하루 전체 상한 ---
VERIFICATION_MAX_PER_IP=10
VERIFICATION_DAILY_LIMIT=30

# --- 개발용 데모 관리자 demo_admin (비밀번호가 소스에 있으므로 배포에서는 끔) ---
DEMO_DATA_ENABLED=false
